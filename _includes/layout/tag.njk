{% extends "layout/base.njk" %}
{% block content %}
    {% from "layout/icons.njk" import icon %}
    <section class="card post-list" aria-labelledby="tag-titel">
        <h1 class="card__title" id="tag-titel">{{ icon("tag") }} Schlagwort: {{ tag.name }}</h1>
        {% for post in tag.posts %}
            {% set postDate = post.data.date | isoDate %}
            <article>
                <header>
                    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
                    <p class="post-meta"><time datetime="{{ postDate }}">{{ postDate }}</time></p>
                </header>
                <div class="teaser">{{ post.content | teaser }}</div>
            </article>
        {% endfor %}
    </section>
    <p><a class="btn" href="/">&larr; Zur Übersicht</a></p>
{% endblock %}
