<!DOCTYPE html>
<html lang="de" class="no-js">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <script>
        (function(){
            var t = localStorage.getItem("pref-theme");
            if (!t) t = matchMedia("(prefers-color-scheme:dark)").matches ? "dark" : "light";
            document.documentElement.dataset.theme = t;
            document.documentElement.className = "js";
        })();
        </script>
        <link href="/css/main.css" rel="stylesheet" />
        <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml" />

        <title>{% if page.url == '/' %}{{ site.title }}{% else %}{{ title }} | {{ site.title }}{% endif %}</title>

        {# Compute description: front matter > post teaser > site default #}
        {%- if description -%}
            {%- set pageDescription = description -%}
        {%- elif layout == 'layout/post.njk' -%}
            {%- set pageDescription = content | teaser(200) -%}
        {%- else -%}
            {%- set pageDescription = site.description -%}
        {%- endif -%}
        <meta name="description" content="{{ pageDescription }}" />

        <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

        {# OpenGraph #}
        <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
        <meta property="og:title" content="{{ title }}" />
        <meta property="og:site_name" content="{{ site.title }}" />
        <meta property="og:locale" content="de_DE" />
        <meta property="og:type" content="{% if layout == 'layout/post.njk' %}article{% else %}website{% endif %}" />
        <meta property="og:description" content="{{ pageDescription }}" />
        {% if cover %}<meta property="og:image" content="{{ site.url }}{{ cover }}" />{% endif %}

        {# Twitter Card #}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="{{ title }}" />
        <meta name="twitter:description" content="{{ pageDescription }}" />
        {% if cover %}<meta name="twitter:image" content="{{ site.url }}{{ cover }}" />{% endif %}

        {# Schema.org JSON-LD #}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": {{ site.title | dump | safe }},
          "url": {{ site.url | dump | safe }},
          "description": {{ site.description | dump | safe }},
          "sameAs": {{ site.social | dump | safe }}
        }
        </script>
        {% if layout == 'layout/post.njk' %}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BlogPosting",
          "headline": {{ title | dump | safe }},
          "url": {{ (site.url + page.url) | dump | safe }},
          "datePublished": {{ date | rfc3339 | dump | safe }},
          "dateModified": {{ date | rfc3339 | dump | safe }},
          "author": {
            "@type": "Person",
            "name": "Marian Hahne"
          },
          "description": {{ pageDescription | dump | safe }}
        }
        </script>
        {% endif %}
    </head>

    <body id="top">
        <div class="utility-bar">
            <div class="wrap utility-bar__inner">
                <nav aria-label="Meta-Navigation">
                    <ul>
                        <li><a href="/meta/layout">Wieso sieht die Seite so aus?</a></li>
                        <li><a href="/meta/kontakt">Kontakt</a></li>
                        <li><a href="/meta/impressum">Impressum</a></li>
                    </ul>
                </nav>
            </div>
        </div>

        <header class="site-header">
            <div class="wrap site-header__inner">
                {% from "layout/icons.njk" import icon %}
                <a class="wordmark" href="/">Marians Blog<span class="badge-beta" aria-hidden="true">beta</span></a>
                <div class="header-actions">
                    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Theme umschalten" title="Theme umschalten">
                        {{ icon("sun") }}{{ icon("moon") }}
                    </button>
                    <a class="feed-link" href="/feed.xml">{{ icon("rss") }}Abonnieren</a>
                </div>
            </div>
        </header>

        <div class="wrap layout">
            <nav class="sidenav" aria-label="Hauptnavigation">
                <ul>
                    <li><a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>Startseite</a></li>
                    <li><a href="/beitraege/"{% if page.url == '/beitraege/' %} aria-current="page"{% endif %}>Beiträge</a></li>
                    <li><a href="/bilder/"{% if page.url == '/bilder/' %} aria-current="page"{% endif %}>Bilder</a></li>
                    <li><a href="/meta/ueber-mich/"{% if page.url == '/meta/ueber-mich/' %} aria-current="page"{% endif %}>Über mich</a></li>
                </ul>

            </nav>

            <main class="site-main">
                {% block content %}
                <p>Ups, diese Seite ist wohl noch leer...</p>
                {% endblock %}
            </main>

            <aside class="sidebar" aria-label="Zusatzinfos">
                {% from "layout/icons.njk" import icon %}
                <details class="gadget" open>
                    <summary>{{ icon("new") }} Neueste Beiträge</summary>
                    <ul class="gadget__list">
                        {% for post in collections.blog %}
                            {% if loop.index <= 5 %}
                            <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </details>

                {% if collections.tagList.length %}
                <details class="gadget" open>
                    <summary>{{ icon("tag") }} Schlagwörter</summary>
                    <p class="tag-cloud">
                        {% for t in collections.tagList %}
                        <a class="tag-cloud__item tag-cloud__item--{{ t.weight }}" href="/tags/{{ t.slug }}/" title="{{ t.posts.length }} {{ 'Beitrag' if t.posts.length == 1 else 'Beiträge' }}">{{ t.name }}</a>
                        {% endfor %}
                    </p>
                </details>
                {% endif %}

                <details class="gadget" open>
                    <summary>{{ icon("info") }} Lizenz</summary>
                    <p class="gadget__text">
                        Alle Inhalte lizenziert unter
                        <a target="_blank" rel="noopener" href="https://creativecommons.org/licenses/by-sa/4.0/deed.de">CC BY-SA 4.0</a>.
                    </p>
                </details>
            </aside>
        </div>

        <footer class="site-footer">
            <p>
                &copy; {{ site.year }} Marian Hahne
                &middot; <a href="/meta/kontakt">Kontakt</a>
                &middot; <a href="/meta/impressum">Impressum</a>
            </p>
        </footer>
        <a class="top-link" id="top-link" href="#top" accesskey="g" title="Nach oben (Alt + G)" aria-label="Nach oben">{{ icon("top") }}</a>
        <script>
        document.getElementById("theme-toggle").addEventListener("click", function() {
            var html = document.documentElement;
            var next = html.dataset.theme === "dark" ? "light" : "dark";
            html.dataset.theme = next;
            localStorage.setItem("pref-theme", next);
        });

        (function() {
            var topLink = document.getElementById("top-link");
            var reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

            function update() {
                topLink.classList.toggle("is-visible", window.scrollY > window.innerHeight);
            }

            window.addEventListener("scroll", update, { passive: true });
            update();

            topLink.addEventListener("click", function(event) {
                event.preventDefault();
                window.scrollTo({ top: 0, behavior: reducedMotion.matches ? "auto" : "smooth" });
                history.replaceState(null, "", window.location.pathname + window.location.search);
            });
        })();
        </script>
    </body>
</html>
