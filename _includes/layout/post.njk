{% extends "layout/base.njk" %}
{% block content %}
  <div class="container">
    <article class="card post">
      <header class="post__header">
        <h1>{{ title }}</h1>
        <p class="post-meta">
          <time datetime="{{ date | isoDate }}">{{ date | isoDate }}</time>
          {% if tags %}
          <span class="tags">{% for tag in tags %}<span class="tag">{{ tag }}</span>{% endfor %}</span>
          {% endif %}
        </p>
      </header>
      <div class="prose post__body">{{ content | safe }}</div>
    </article>
  </div>
{% endblock %}
