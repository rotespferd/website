{% extends "layout/base.njk" %}
{% block content %}
    {% from "layout/icons.njk" import icon, socialIcon %}
    <p class="notice" role="status">Diese Seite ist noch im Aufbau (Beta). Manches funktioniert noch nicht.</p>

    <section class="homepage-intro">
        {{ content | safe }}
        <p><a class="btn-cta" href="#beitraege">Beiträge lesen</a></p>
        <p class="social-links" aria-label="Ich im Netz">
            {% for profile in site.profiles %}
            <a class="social-link social-link--{{ profile.icon }}" href="{{ profile.url }}" target="_blank" rel="noopener noreferrer me" title="{{ profile.name }}" aria-label="{{ profile.name }}">{{ socialIcon(profile.icon) }}</a>
            {% endfor %}
        </p>
    </section>

    <section class="card post-list" id="beitraege" aria-labelledby="beitraege-titel">
        <h2 class="card__title" id="beitraege-titel">{{ icon("list") }} Beiträge</h2>
        {% for post in collections.blog %}
            {% if loop.index <= 5 %}
            {% set postDate = post.data.date | isoDate %}
            <article>
                <header>
                    <h3>{% if loop.first %}<span class="starburst">Neu!</span>{% endif %}<a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                    <p class="post-meta">
                        {% if post.data.tags %}
                        <span class="tags">{% for tag in post.data.tags %}<a class="tag" href="/tags/{{ tag | slugify }}/">{{ tag }}</a>{% endfor %}</span>
                        {% endif %}
                        <time datetime="{{ postDate }}">{{ postDate }}</time>
                    </p>
                </header>

                {% if post.data.cover %}<img class="cover cover--thumb" src="{{ post.data.cover }}" alt="" loading="lazy" decoding="async" onload="this.classList.add('loaded')">{% endif %}
                <div class="teaser">{{ post.content | teaser }}</div>
            </article>
            {% endif %}
        {% endfor %}
    </section>
    <p><a class="btn" href="/beitraege/">Alle Beiträge &rarr;</a></p>
{% endblock %}
