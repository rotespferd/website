{% extends "layout/base.njk" %}
{% block content %}
    <section class="container homepage-intro">
        {{ content | safe }}
    </section>

    <section class="container post-list" aria-label="Blogposts">
        {% for post in collections.blog %}
            {% set postDate = post.data.date | isoDate %}
            <article>
                <header>
                    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
                    <p class="post-meta">
                        <time datetime="{{ postDate }}">{{ postDate }}</time>
                        {% if post.data.tags %}
                        <span class="tags">{% for tag in post.data.tags %}<span class="tag">{{ tag }}</span>{% endfor %}</span>
                        {% endif %}
                    </p>
                </header>

                <div class="teaser">{{ post.content | teaser }}</div>
            </article>
        {% endfor %}
    </section>
{% endblock %}
