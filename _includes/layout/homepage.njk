{% extends "layout/base.njk" %}
{% block content %}
    <section class="container">
        {{ content | safe }}
    </section>

    <section class="container" aria-label="Blogposts">
        {% for post in collections.blog %}
            {% set postDate = post.data.date | isoDate %}
            <article>
                <header>
                    <h3>{{ post.data.title }}</h3>
                    <p class="post-meta"><time datetime="{{ postDate }}">{{ postDate }}</time></p>
                </header>

                <div>{{ post.content | safe }}</div>
            </article>
        {% endfor %}
    </section>
{% endblock %}
