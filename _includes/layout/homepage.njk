{% extends "layout/base.njk" %}
{% block content %}
    <section class="container">
        {{ content | safe }}
    </section>

    <section class="container" aria-label="Blogposts">
        {% for post in collections.blog %}
            {% set postDate = post.data.date | isoDate %}
            <article>
                <header>
                    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                    <p class="post-meta">
                        <time datetime="{{ postDate }}">{{ postDate }}</time>
                        {% if post.data.tags %}
                        <span class="tags">{% for tag in post.data.tags %}{{ tag }}{% if not loop.last %}, {% endif %}{% endfor %}</span>
                        {% endif %}
                    </p>
                </header>

                <div class="teaser">{{ post.content | teaser }}</div>
            </article>
        {% endfor %}
    </section>
{% endblock %}
